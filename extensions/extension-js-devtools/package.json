{
  "private": true,
  "name": "extension-js-devtools",
  "description": "Extension.js built-in companion: first-run welcome page and browser tab setup",
  "version": "3.0.0",
  "author": {
    "name": "Cezar Augusto",
    "email": "boss@cezaraugusto.net",
    "url": "https://cezaraugusto.com"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:chromium": "node ../../programs/extension/dist/cli.cjs build ./src --browser=chromium --no-telemetry",
    "build:chrome": "node ../../programs/extension/dist/cli.cjs build ./src --browser=chrome --no-telemetry",
    "build:firefox": "node ../../programs/extension/dist/cli.cjs build ./src --browser=firefox --no-telemetry",
    "build:edge": "node ../../programs/extension/dist/cli.cjs build ./src --browser=edge --no-telemetry"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.37",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "extension": "workspace:*",
    "clsx": "^2.1.1",
    "postcss": "^8.5.12",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.3",
    "typescript": "7.0.2"
  }
}
