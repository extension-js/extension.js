{
  "type": "module",
  "name": "@extension-js/theme",
  "private": true,
  "version": "0.1.0",
  "description": "Dark Chromium and Firefox browser theme with neutral gray frame, toolbar and new tab colors.",
  "license": "MIT",
  "scripts": {
    "build:chromium": "node ../../programs/extension/dist/cli.cjs build . --browser=chromium --no-telemetry",
    "build:chrome": "node ../../programs/extension/dist/cli.cjs build . --browser=chrome --no-telemetry",
    "build:firefox": "node ../../programs/extension/dist/cli.cjs build . --browser=firefox --no-telemetry",
    "build:edge": "node ../../programs/extension/dist/cli.cjs build . --browser=edge --no-telemetry"
  },
  "keywords": [
    "chrome",
    "theme",
    "dark"
  ]
}
