{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "noEmit": true,
    "noEmitOnError": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "rootDir": "..",
    "paths": {
      "extension-create": ["./node_modules/extension-create/module.ts"],
      "extension-develop": ["./node_modules/extension-develop/module.ts"],
      "extension-develop/bridge": [
        "./node_modules/extension-develop/bridge-entry.ts"
      ],
      "extension-develop/contracts": [
        "./node_modules/extension-develop/contracts-entry.ts"
      ],
      "extension-develop/preview": [
        "./node_modules/extension-develop/preview-entry.ts"
      ],
      "extension-install": ["./node_modules/extension-install/module.ts"]
    },
    "types": ["node", "webextension-polyfill", "chrome"]
  },
  "include": ["**/*.ts", "browsers/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.spec.ts",
    "**/__spec__/**",
    "rslib.config.ts",
    "vitest.config.ts"
  ]
}
