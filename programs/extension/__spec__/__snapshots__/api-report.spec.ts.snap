}

## extension/config-types#SpecialFoldersConfig
interface SpecialFoldersConfig {
    scripts?: string | false;
    pages?: string | false;
    public?: string | false;
}

## extension/config-types#StartCommandConfig
interface StartCommandConfig extends ServeCommandConfig {
    perfBudgets?: PerfBudgetsConfig;
}

## extension/config-types#UnifiedLoggerConfig
interface UnifiedLoggerConfig {
    logLevel?: 'off' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'all';
    logContexts?: ('background' | 'content' | 'page' | 'sidebar' | 'popup' | 'options' | 'devtools' | 'newtab' | 'history' | 'bookmarks')[];
    logFormat?: 'pretty' | 'json' | 'ndjson';
    logTimestamps?: boolean;
    logColor?: boolean;
    logUrl?: string;
    logTab?: number | string;
}"
