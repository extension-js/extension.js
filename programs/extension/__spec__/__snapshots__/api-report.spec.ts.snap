    minify?: boolean;
}

## extension/config-types#IncludeFilesConfig
type IncludeFilesConfig = Record<string, string | IncludeFileEntry>;

## extension/config-types#PerfBudgetCategory
type PerfBudgetCategory = 'content-script' | 'service-worker' | 'page' | 'shared' | 'public' | 'runtime' | 'wasm';

## extension/config-types#PerfBudgetsConfig
type PerfBudgetsConfig = Partial<Record<PerfBudgetCategory, number>> & {
    ignore?: string[];
    onExceed?: 'warn' | 'error';
};

## extension/config-types#PreviewCommandConfig
interface PreviewCommandConfig extends Omit<ServeCommandConfig, 'polyfill' | 'include' | 'exclude'> {
