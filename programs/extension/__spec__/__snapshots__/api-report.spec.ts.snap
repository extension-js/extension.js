## extension/config-types#BrowserConfig
interface BrowserConfig extends BrowserLaunchConfig, SafariConfig {
    browser?: BrowserType;
    profile?: string | false;
    keepProfileChanges?: boolean;
    copyFromProfile?: string;
    startingUrl?: string;
    noOpen?: boolean;
    chromiumBinary?: string;
    geckoBinary?: string;
    firefoxBinary?: string;
    folders?: SpecialFoldersConfig;
    include?: IncludeFilesConfig;
    exclude?: ExcludeFilesConfig;
    define?: Record<string, unknown>;
    perfBudgets?: PerfBudgetsConfig;
}

## extension/config-types#BrowserLaunchConfig
interface BrowserLaunchConfig {
    browserFlags?: string[];
    excludeBrowserFlags?: string[];
    preferences?: Record<string, unknown>;
    persistProfile?: boolean;
    extensions?: CompanionExtensionsConfig;
    transpilePackages?: string[];
}

## extension/config-types#BrowserType
type BrowserType = 'chrome' | 'edge' | 'firefox' | 'chromium' | 'brave' | 'opera' | 'vivaldi' | 'yandex' | 'waterfox' | 'librewolf' | 'zen' | 'floorp' | 'chromium-based' | 'gecko-based' | 'firefox-based' | 'safari' | 'webkit-based' | 'chromium-emulator';

## extension/config-types#BuildCommandConfig
interface BuildCommandConfig extends SafariConfig {
    browser?: BrowserType;
    outDir?: string;
    polyfill?: boolean;
    zip?: boolean;
    zipSource?: boolean;
    zipFilename?: string;
    zipDir?: string;
    sourceMaps?: boolean;
    silent?: boolean;
    addonLint?: boolean;
    minify?: boolean;
    extensions?: CompanionExtensionsConfig;
    transpilePackages?: string[];
    perfBudgets?: PerfBudgetsConfig;
    define?: Record<string, unknown>;
    folders?: SpecialFoldersConfig;
    include?: IncludeFilesConfig;
    exclude?: ExcludeFilesConfig;
}

## extension/config-types#CompanionExtensionsConfig
type CompanionExtensionsConfig = string[] | {
    dir?: string;
    paths?: string[];
};

## extension/config-types#ConfigHookContext
interface ConfigHookContext {
    browser: BrowserType;
    mode: 'development' | 'production' | 'none';
    command: 'dev' | 'build' | 'start' | 'preview';
    rspack: any;
}

## extension/config-types#DevCommandConfig
interface DevCommandConfig extends BrowserLaunchConfig, UnifiedLoggerConfig, SafariConfig {
    browser?: BrowserType;
    profile?: string | false;
    chromiumBinary?: string;
    geckoBinary?: string;
    noOpen?: boolean;
    noBrowser?: boolean;
    polyfill?: boolean;
    hashContentScripts?: boolean;
    perfBudgets?: PerfBudgetsConfig;
    define?: Record<string, unknown>;
    folders?: SpecialFoldersConfig;
    include?: IncludeFilesConfig;
    exclude?: ExcludeFilesConfig;
}

## extension/config-types#ExcludeFilesConfig
type ExcludeFilesConfig = string[];

## extension/config-types#FileConfig
interface FileConfig {
    browser?: {
        [K in BrowserType]?: BrowserConfig;
    };
    commands?: {
        dev?: DevCommandConfig;
        start?: StartCommandConfig;
        preview?: PreviewCommandConfig;
        build?: BuildCommandConfig;
    };
    extensions?: CompanionExtensionsConfig;
    transpilePackages?: string[];
    perfBudgets?: PerfBudgetsConfig;
    define?: Record<string, unknown>;
    folders?: SpecialFoldersConfig;
    include?: IncludeFilesConfig;
    exclude?: ExcludeFilesConfig;
    config?: (config: any, context: ConfigHookContext) => any;
    configResolved?: (config: any, context: ConfigHookContext) => any;
}

## extension/config-types#IncludeFileEntry
interface IncludeFileEntry {
