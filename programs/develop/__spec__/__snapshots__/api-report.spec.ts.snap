}

## develop/plugin-browsers/index#BuildEventMap
interface BuildEventMap {
    compiled: [CompiledEvent];
    error: [BuildErrorEvent];
}

## develop/plugin-browsers/index#CompiledEvent
interface CompiledEvent {
    outputPath: string;
    contextDir: string;
    isFirstCompile: boolean;
    reloadInstruction?: ReloadInstruction;
    extensionsToLoad?: string[];
}

## develop/plugin-browsers/index#ExtensionLoadRetryResult
interface ExtensionLoadRetryResult {
    status: 'loaded' | 'refused' | 'unknown';
    reason?: string;
    extensionId?: string;
}

## develop/plugin-perf-budgets/categorize#ASSET_CATEGORIES
