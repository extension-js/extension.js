    locateInstalledBinary: (destination: string, browser: InstallBrowserTarget) => string | null;
    runInstaller?: typeof runCommand;
    stdinIsTTY?: boolean;
    isRoot?: boolean;
    systemEdge?: SystemEdgeLookup;
    removeTree?: (dir: string) => void;
    lock?: LockSeams;
}

## install/module#UninstallOptions
