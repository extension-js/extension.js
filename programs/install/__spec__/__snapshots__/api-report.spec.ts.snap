}

## install/lib/runner#SignalSource
interface SignalSource {
    on: (signal: ForwardedSignal, listener: () => void) => unknown;
    off: (signal: ForwardedSignal, listener: () => void) => unknown;
}

## install/lib/runner#SpawnProcess
type SpawnProcess = (command: string, args: string[], options: SpawnOptions) => ChildProcess;

## install/lib/runner#SystemEdgeLookup
interface SystemEdgeLookup {
