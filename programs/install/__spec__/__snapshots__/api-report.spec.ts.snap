    registry?: (key: string) => string | null;
}

## install/lib/runner#runCommand
declare function runCommand(command: string, args: string[], opts: RunCommandOptions): Promise<CommandResult>;

## install/module#InstallOptions
interface InstallOptions extends InstallPlanOptions {
    browser: string;
