{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "files": {
    "ignoreUnknown": true,
    "maxSize": 262144,
    "includes": [
      "**",
      "!_FUTURE",
      "!extensions/browser-extension",
      "!.claude",
      "!test-results",
      "!test-results.json",
      "!**/extension-env.d.ts",
      "!templates",
      "!.prod-dist",
      "!programs/create/templates",
      "!**/dist",
      "!**/.rslib",
      "!**/build",
      "!**/out",
      "!**/coverage",
      "!**/e2e-report",
      "!**/playwright-report",
      "!**/.next",
      "!**/.nuxt",
      "!**/.svelte-kit",
      "!**/.vite",
      "!**/.cache",
      "!**/.turbo",
      "!**/.pnpm-store",
      "!**/__TEST__",
      "!**/webpack.config.js",
      "!**/postcss.config.js",
      "!**/tailwind.config.js",
      "!**/stylelint.config.json",
      "!**/.tmp-*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "none",
      "bracketSpacing": false,
      "semicolons": "asNeeded",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": ["extensions/extension-js-devtools/**/*.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    },
    {
      "includes": [
        "programs/develop/**/__spec__/**",
        "programs/develop/**/*.spec.ts",
        "programs/extension/**/__spec__/**",
        "programs/extension/**/*.spec.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noPrototypeBuiltins": "off",
        "noControlCharactersInRegex": "off",
        "useIterableCallbackReturn": "error",
        "noAssignInExpressions": "off",
        "noAsyncPromiseExecutor": "error",
        "noImplicitAnyLet": "error"
      }
    }
  }
}
