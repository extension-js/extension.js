{
  // The shared script helpers also refuse implicit any, every one of them.
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Script helpers",
  "extends": "./tsconfig.scripts.json",
  "compilerOptions": {
    "noImplicitAny": true
  },
  "include": [
    "./scripts/lib/**/*.mjs",
    "./scripts/lib/**/*.cjs",
    "./scripts/lib/**/*.js",
    "./scripts/lib/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
