EXTENSION_DEBUG=

# --- Publish and share services --------------------------------------------
# Host and token for the publish command. Leave these empty and publish
# refuses with its remedy.
EXTENSION_DEV_API_URL=
EXTENSION_DEV_TOKEN=

# --- Telemetry -------------------------------------------------------------
# CLI write side (a public project key, safe to commit and publish)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional overrides (defaults are sane for the free tier)
# EXTENSION_TELEMETRY_DISABLED=1          # disable entirely (preferred switch)
# EXTENSION_TELEMETRY=0                   # older form, also honored
# EXTENSION_TELEMETRY_SAMPLE_RATE=0.2     # 0.0–1.0, applies to command_executed only
# EXTENSION_TELEMETRY_MAX_EVENTS=3        # per-run cap
# EXTENSION_TELEMETRY_DEBOUNCE_MS=60000   # dedup window per (event,command,success,session)
# EXTENSION_TELEMETRY_DEBUG=1             # print payloads to stderr

