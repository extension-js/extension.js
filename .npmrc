auto-install-peers=true
strict-peer-dependencies=false
ignore-workspace-root-check=true

# Dependabot re-resolves the lockfile under pnpm's three-day release-age gate
# (4320 minutes); resolving locally under the same rule keeps every entry it
# writes acceptable to that job, so its PR recreations stop failing.
minimum-release-age=4320
# image-size 2.0.3 fixed CVE-2025-71329 and CVE-2025-71330 the day it shipped, the
# three day wait would keep the vulnerable 2.0.2 that addons-linter pulls in.
minimum-release-age-exclude[]=image-size
minimum-release-age-exclude[]=browser-extension-manifest-fields
