{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "types": ["node", "chrome"],
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "ESNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true
  },
  "include": ["./programs/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/__spec__/**",
    "**/*.spec.ts",
    "./examples/**",
    "./templates/**",
    // These load chrome-types, which cannot share a program with the
    // @types/chrome this source is written against. A generator spec checks them.
    "./programs/extension/types/index.d.ts",
    "./programs/extension/types/firefox.d.ts",
    "./programs/extension/types/chrome.d.ts",
    "./programs/extension/types/callbacks.d.ts",
    "./programs/extension/types/enums.d.ts"
  ]
}
