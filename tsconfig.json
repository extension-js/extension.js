{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "types": ["node", "chrome"],
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "ESNext",
    "noEmit": true,
    // Nothing is written, but an export whose type cannot be named is
    // reported here instead of first at compile, where declarations are built.
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    // Workspace packages are read from source here, never from dist. The
    // published manifests name built files only, so the map lives in this file.
    "paths": {
      "extension-create": ["./programs/create/module.ts"],
      "extension-develop": ["./programs/develop/module.ts"],
      "extension-develop/bridge": ["./programs/develop/bridge-entry.ts"],
      "extension-develop/contracts": ["./programs/develop/contracts-entry.ts"],
      "extension-develop/preview": ["./programs/develop/preview-entry.ts"],
      "extension-install": ["./programs/install/module.ts"]
    }
  },
  "include": ["./programs/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/__spec__/**",
    "**/*.spec.ts",
    "./templates/**",
    // These load chrome-types, which cannot share a program with the
    // @types/chrome this source is written against. A generator spec checks them.
    "./programs/extension/types/index.d.ts",
    "./programs/extension/types/firefox.d.ts",
    "./programs/extension/types/chrome.d.ts",
    "./programs/extension/types/callbacks.d.ts",
    "./programs/extension/types/enums.d.ts"
  ]
}
