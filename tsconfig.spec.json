{
  // The root project excludes every spec path. This one adds them back, so a
  // mock that falls behind the class it stands in for fails the typecheck
  // gate. Every spec passes: a spec that does not is fixed, not listed here.
  // scripts/__spec__/tsconfig-spec-ratchet.spec.mjs pins this exclude list.
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Specs",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "chrome", "webextension-polyfill"]
  },
  "include": ["./programs/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "./examples/**", "./templates/**"]
}
